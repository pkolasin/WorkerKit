{
  "HostOptions": {
    "ShutdownTimeout": "00:00:15"
  },
  "OpenMeteo": {
    "Enabled": true,
    "PollIntervalSeconds": 300,
    "BaseAddress": "https://api.open-meteo.com/v1/",
    "UserAgent": "WorkerKitExample/1.0",
    "Resilience": {
      "MaxRetryAttempts": 3,
      "RetryDelaySeconds": 1,
      "AttemptTimeoutSeconds": 10,
      "TotalRequestTimeoutSeconds": 60,
      "CircuitBreakerSamplingSeconds": 30,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerBreakDurationSeconds": 30
    }
  },
  "Vies": {
    "Endpoint": "https://ec.europa.eu/taxation_customs/vies/services/checkVatService",
    "TimeoutSeconds": 30
  },
  "Mqtt": {
    "Provider": "Mosquitto",
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "ClientId": "workerkit-sample",
    "Topic": "workerkit/samples/outbound",
    "Username": "",
    "Password": "",
    "DeviceId": "",
    "DeviceSecret": "",
    "SasLifetimeMinutes": 60
  },
  "Sms": {
    "Provider": "DryRun",
    "AccountSid": "",
    "AuthToken": "",
    "From": "",
    "TimeoutSeconds": 30
  },
  "Queue": {
    "vies-queue": {
      "Enabled": false,
      "BatchSize": 10,
      "MaxConcurrency": 1,
      "LeaseDuration": "00:01:00",
      "MaxAttempts": 5,
      "RetryDelay": "00:00:05",
      "MinIdleDelay": "00:00:01",
      "MaxIdleDelay": "00:00:30",
      "CountryCode": "",
      "VatNumber": ""
    },
    "outbound-queue": {
      "Enabled": false,
      "BatchSize": 10,
      "MaxConcurrency": 1,
      "LeaseDuration": "00:01:00",
      "MaxAttempts": 5,
      "RetryDelay": "00:00:05",
      "MinIdleDelay": "00:00:01",
      "MaxIdleDelay": "00:00:30",
      "ExampleKind": "",
      "ExampleDestination": "",
      "ExampleBody": ""
    }
  },
  "Health": {
    "PublisherPeriodSeconds": 60,
    "ListenUrl": "",
    "HeartbeatStaleMultiplier": 3,
    "HeartbeatGracePadding": "00:05:00"
  },
  "Telemetry": {
    "ServiceName": "WorkerKitExample"
  },
  "LogFile": {
    "Path": "logs/worker-.json",
    "RetainedFileCount": 14,
    "FlushIntervalSeconds": 1
  },
  "Instance": {
    "DataDirectory": "data",
    "TempDirectory": "temp",
    "CleanTempOnStart": true,
    "RequireLock": true
  },
  "Data": {
    "Provider": "None",
    "ConnectionString": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{Instance}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
