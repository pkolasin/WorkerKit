<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <IsPackable>true</IsPackable>
    <RootNamespace>WorkerKit.Hosting</RootNamespace>
    <Description>Generic host, CLI, health checks, Serilog, OpenTelemetry, and worker execution for WorkerKit.</Description>
    <PackageDescription>Generic host, CLI, health checks, Serilog, OpenTelemetry, and worker execution for WorkerKit.</PackageDescription>
    <PackageTags>workerkit;worker;hosting</PackageTags>
    <!-- Deploy scripts are content copied at publish. They are not NuGet tools/install.ps1 scripts. -->
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkerKit.Abstractions\WorkerKit.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build/**/*" Exclude="build/**/*.Tests.ps1" Pack="true" PackagePath="build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildTransitive/**/*" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
