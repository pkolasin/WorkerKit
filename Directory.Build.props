<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Company>WorkerKit</Company>
    <Product>WorkerKit</Product>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Set before the SDK reads GenerateDocumentationFile. Directory.Build.targets is too late: the SDK
       has already decided not to pass /doc. Samples, tests, ExampleHost, and the template package stay out. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WorkerKit.Abstractions' or '$(MSBuildProjectName)' == 'WorkerKit.Hosting' or '$(MSBuildProjectName)' == 'WorkerKit.Soap' or '$(MSBuildProjectName)' == 'WorkerKit.Testing'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
</Project>
